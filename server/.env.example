# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas)
# If local MongoDB is not running, Taskora will automatically boot an in-memory MongoDB instance in development!
MONGO_URI=mongodb://127.0.0.1:27017/taskora

# Authentication (JWT)
JWT_SECRET=taskora_development_jwt_secret_key_change_in_production_123456
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173
